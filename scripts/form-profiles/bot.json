{
  "id": "bot",
  "description": "Форма из Telegram-бота: time, user_id, team, p1..p5, s1, s2, tg, logo",
  "detect": [{ "equals": "user_id" }, { "equals": "team" }, { "equals": "p1" }],
  "columns": {
    "time":    { "equals": "time" },
    "team":    { "equals": "team" },
    "logo":    { "equals": "logo" },
    "captain": { "equals": "tg" },
    "players": { "pattern": "^p(\\d)$" },
    "subs":    { "pattern": "^s(\\d)$" }
  },
  "cell": {
    "fields": ["nick", "mmr", "steam", "dotabuff", "telegram", "discord"]
  }
}
